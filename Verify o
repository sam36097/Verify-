html_content = '''<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Certificate Verification Portal</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px;
        }
        
        .container {
            background: white;
            border-radius: 20px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            padding: 50px;
            max-width: 500px;
            width: 100%;
            text-align: center;
        }
        
        .logo {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 50%;
            margin: 0 auto 25px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 36px;
            color: white;
        }
        
        h1 {
            color: #333;
            margin-bottom: 10px;
            font-size: 28px;
        }
        
        .subtitle {
            color: #888;
            margin-bottom: 35px;
            font-size: 14px;
        }
        
        .input-group {
            position: relative;
            margin-bottom: 25px;
        }
        
        input[type="text"] {
            width: 100%;
            padding: 15px 20px;
            border: 2px solid #e0e0e0;
            border-radius: 12px;
            font-size: 16px;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 1px;
        }
        
        input[type="text"]:focus {
            outline: none;
            border-color: #667eea;
        }
        
        .verify-btn {
            width: 100%;
            padding: 16px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            border-radius: 12px;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .verify-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.4);
        }
        
        .verify-btn:active {
            transform: translateY(0);
        }
        
        .result {
            margin-top: 30px;
            padding: 25px;
            border-radius: 12px;
            display: none;
            animation: fadeIn 0.5s ease;
        }
        
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        .result.success {
            display: block;
            background: #d4edda;
            border: 1px solid #c3e6cb;
            color: #155724;
        }
        
        .result.error {
            display: block;
            background: #f8d7da;
            border: 1px solid #f5c6cb;
            color: #721c24;
        }
        
        .result-icon {
            font-size: 48px;
            margin-bottom: 10px;
        }
        
        .result h2 {
            font-size: 20px;
            margin-bottom: 8px;
        }
        
        .result p {
            font-size: 14px;
            line-height: 1.6;
        }
        
        .details {
            margin-top: 15px;
            padding-top: 15px;
            border-top: 1px solid rgba(0,0,0,0.1);
            text-align: left;
        }
        
        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 8px;
            font-size: 13px;
        }
        
        .detail-label {
            font-weight: 600;
        }
        
        .footer {
            margin-top: 30px;
            color: #aaa;
            font-size: 12px;
        }
        
        .loading {
            display: none;
            margin-top: 20px;
        }
        
        .loading.active {
            display: block;
        }
        
        .spinner {
            width: 40px;
            height: 40px;
            border: 4px solid #f3f3f3;
            border-top: 4px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto;
        }
        
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="logo">✓</div>
        <h1>Certificate Verification</h1>
        <p class="subtitle">Enter your certificate serial number to verify authenticity</p>
        
        <div class="input-group">
            <input type="text" id="serialInput" placeholder="e.g., CERT-2024-001234" autocomplete="off">
        </div>
        
        <button class="verify-btn" onclick="verifyCertificate()">Verify Certificate</button>
        
        <div class="loading" id="loading">
            <div class="spinner"></div>
            <p style="margin-top: 10px; color: #888; font-size: 14px;">Verifying...</p>
        </div>
        
        <div class="result" id="result">
            <div class="result-icon" id="resultIcon"></div>
            <h2 id="resultTitle"></h2>
            <p id="resultMessage"></p>
            <div class="details" id="details"></div>
        </div>
        
        <div class="footer">
            Secure Verification System &copy; 2026
        </div>
    </div>

    <script>
        // ============================================
        // VALID SERIAL NUMBERS DATABASE
        // Add your valid serial numbers here
        // ============================================
        const validCertificates = {
            "123": {
                name: "Certificate Holder",
                course: "Certified Program",
                date: "May 2, 2026",
                issuer: "Authorized Institution"
            },
            "CERT-2024-001": {
                name: "John Doe",
                course: "Advanced Web Development",
                date: "March 15, 2024",
                issuer: "Tech Academy"
            },
            "CERT-2024-002": {
                name: "Jane Smith",
                course: "Data Science Fundamentals",
                date: "April 20, 2024",
                issuer: "Tech Academy"
            }
        };
        
        const serialInput = document.getElementById('serialInput');
        const result = document.getElementById('result');
        const loading = document.getElementById('loading');
        
        serialInput.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') verifyCertificate();
        });
        
        function verifyCertificate() {
            const serial = serialInput.value.trim().toUpperCase();
            
            if (!serial) {
                showResult('error', '⚠️', 'Input Required', 'Please enter a certificate serial number.');
                return;
            }
            
            // Show loading
            result.className = 'result';
            loading.classList.add('active');
            
            // Simulate verification delay (1.5 seconds)
            setTimeout(() => {
                loading.classList.remove('active');
                
                const cert = validCertificates[serial];
                
                if (cert) {
                    showResult('success', '✅', 'Certificate Verified', 
                        `This certificate has been verified as authentic and issued by ${cert.issuer}.`);
                    
                    document.getElementById('details').innerHTML = `
                        <div class="detail-row">
                            <span class="detail-label">Recipient:</span>
                            <span>${cert.name}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Course/Program:</span>
                            <span>${cert.course}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Issue Date:</span>
                            <span>${cert.date}</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">Serial Number:</span>
                            <span>${serial}</span>
                        </div>
                    `;
                } else {
                    showResult('error', '❌', 'Invalid Certificate', 
                        'The serial number you entered could not be found in our database. Please check the number and try again, or contact support if you believe this is an error.');
                    document.getElementById('details').innerHTML = '';
                }
            }, 1500);
        }
        
        function showResult(type, icon, title, message) {
            result.className = 'result ' + type;
            document.getElementById('resultIcon').textContent = icon;
            document.getElementById('resultTitle').textContent = title;
            document.getElementById('resultMessage').textContent = message;
        }
    </script>
</body>
</html>'''

with open('/mnt/agents/output/certificate_verifier.html', 'w') as f:
    f.write(html_content)

print("Updated with serial number '123' as valid!")
